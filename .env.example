# Node 24+. Copie para .env. Nenhum segredo usa prefixo VITE_.
PORT=5173
APP_URL=http://localhost:5173
STORE_MODE=demo
# Modos: demo (simulador local), sandbox (Mercado Pago TEST- + HTTPS), live (produção).
DATABASE_PATH=./data/drika.sqlite
# Vercel: banco remoto obrigatório para contas/pedidos. Não use DATABASE_PATH na nuvem.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Valor aleatório de pelo menos 32 bytes para autenticar a manutenção agendada.
CRON_SECRET=
# Somente na primeira inicialização: senha administrativa de 12 a 128 caracteres.
# Remova após criar a conta. Alternativa local: npm run admin:create -- --generate
ADMIN_INITIAL_PASSWORD=
# Produção: HTTPS, STORE_MODE=live, catálogo real e todas as pendências resolvidas.
PAYMENT_PROVIDER=demo
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MAX_INSTALLMENTS=1
# Credenciais de teste primeiro. Não use credenciais reais na demonstração.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Alternativa para Vercel: conteúdo PEM completo da chave, com quebras reais ou \n.
APPLE_PRIVATE_KEY=
